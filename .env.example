# RAG 知识库问答系统环境变量配置

# LLM配置（OpenAI兼容接口均可，如美团LongCat）
OPENAI_API_KEY=your_api_key_here
# LongCat示例: https://api.longcat.chat/openai/v1  模型: LongCat-2.0
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 嵌入模型：中文推荐 models/bge-small-zh-v1.5（需自行下载权重放该目录，切换后跑 POST /api/v1/documents/reindex）；
# 不下载模型时用 chromadb 内置 ONNX MiniLM（开箱即用，中文效果一般）
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./vector_db
CHROMA_COLLECTION_NAME=documents

# 文档存储配置
DOCUMENT_STORAGE_PATH=./data
MAX_UPLOAD_SIZE_MB=50

# RAG参数配置
# 重排通道：ce=本地cross-encoder(默认，需下载 bge-reranker-base 权重到 RERANKER_MODEL 目录) / llm=LLM listwise / off=不重排
RERANK_MODE=ce
RERANKER_MODEL=models/bge-reranker-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEARCH_K=4  # 返回的相似文档数量

# FastAPI配置
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# 安全配置
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]